# SleepJiraBot runs as a fleet of microservices that share this .env:
#   bot              — OAuth /callback, web pages, calendar poller (:8080)
#   identity-svc     — Jira token lease + refresh (:9080)
#   preferences-svc  — user preferences (:9082)
#   subscription-svc — Jira polling (:8082)
#   scheduler-svc    — cron reports (:8083)
#   webhook-svc      — webhook ingress + refresher (:8081)
#   telegram-svc     — Telegram update-handling + notification delivery (:8084)
# NATS is mandatory (event bus); Jira tokens are leased from identity-svc.

TELEGRAM_TOKEN=your-telegram-bot-token
MONGO_URI=mongodb://localhost:27017
MONGO_DB=sleepjirabot
LOG_LEVEL=debug

# Jira Cloud OAuth 2.0 (create app at https://developer.atlassian.com/console/myapps/)
JIRA_CLIENT_ID=your-jira-client-id
JIRA_CLIENT_SECRET=your-jira-client-secret
JIRA_REDIRECT_URI=https://apenkin.pro/jira-bot/callback
# Public HTTPS URL Jira posts dynamic-webhook events to. Required —
# Atlassian's POST /rest/api/3/webhook expects this URL in the body and
# rejects registrations whose host does not match the OAuth app's base.
JIRA_WEBHOOK_URL=https://apenkin.pro/jira-bot/webhook
# Required by webhook-svc (the only binary that serves /webhook): the
# handler verifies X-Hub-Signature against this secret on every POST.
# Wire the same value into Jira out-of-band (Connect app / reverse-proxy
# hook). If left empty, webhook-svc refuses to start unless
# ALLOW_UNSIGNED_WEBHOOKS=true is set — see below.
JIRA_WEBHOOK_SECRET=your-jira-webhook-secret
# Opt back into accepting unsigned POSTs (legacy behaviour). Use only
# when /webhook is genuinely protected by network ACL or reverse-proxy
# auth; otherwise an attacker who learns the URL can fan out forged
# notifications.
# ALLOW_UNSIGNED_WEBHOOKS=false
POLL_INTERVAL=30s
BATCH_WINDOW=1m
CALLBACK_ADDR=:8080

# 32-byte key for AES-256-GCM token encryption (64 hex characters)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your-64-char-hex-encryption-key
# Optional second key used as a Decrypt fallback during rotation. Set
# this to the OLD ENCRYPTION_KEY value when rolling out a new primary
# key — existing ciphertexts decrypt under the previous key while new
# writes use the primary. Remove once every record has been re-encrypted
# (or after the relevant collection's retention window passes).
# ENCRYPTION_KEY_PREVIOUS=

# SOCKS5 proxy for all outbound connections (optional)
# PROXY_URL=socks5://user:password@host:port

# Admin panel (optional) — your Telegram user ID
# ADMIN_TELEGRAM_ID=123456789

# NATS JetStream event bus. Mandatory for every service — a connection
# failure is fatal at startup.
NATS_URL=nats://localhost:4222

# Inter-service endpoints. In docker compose these resolve to the service
# names; set them when running services separately.
#   IDENTITY_SVC_URL    — required by bot, subscription-svc, scheduler-svc,
#                         webhook-svc, telegram-svc (token lease).
#   PREFERENCES_SVC_URL — required by telegram-svc.
#   WEBHOOK_SVC_URL     — required by telegram-svc (admin stats counter).
IDENTITY_SVC_URL=http://identity-svc:9080
PREFERENCES_SVC_URL=http://preferences-svc:9082
WEBHOOK_SVC_URL=http://webhook-svc:8081

# Shared bearer secret guarding the internal endpoints (identity-svc
# /internal/lease, preferences-svc, webhook-svc /internal/stats). Empty
# disables auth and the listeners must be protected at the network layer.
INTERNAL_AUTH_TOKEN=change-me

# Per-service HTTP listen addresses (health/readiness + internal APIs).
# INTERNAL_ADDR=:9080
# WEBHOOK_SVC_ADDR=:8081
# SUBSCRIPTION_SVC_ADDR=:8082
# SCHEDULER_SVC_ADDR=:8083
# TELEGRAM_SVC_ADDR=:8084
# PREFERENCES_SVC_ADDR=:9082

# Distributed notification dedup. Without this, notifydedup runs
# in-process — fine for a single replica per service, but it will
# double-notify when a notifying service (subscription-svc, webhook-svc,
# bot calendar poller) runs with more than one replica. Point at a shared
# Redis to converge on a single notification per (chat_id, key) window.
# DEDUP_REDIS_URL=redis://redis:6379/0

# Persist Telegram FSM (wizard progress) in Mongo so conversation state
# survives telegram-svc restarts. Stored in `conversation_states` with a
# TTL index matching the in-code 15m expiry. Default false keeps the
# in-memory map (fine for a single telegram-svc replica).
# PERSIST_CONVERSATION_STATES=false

# OpenTelemetry. When OTEL_EXPORTER_OTLP_ENDPOINT is set, each service
# installs an OTLP/gRPC tracer + meter provider pointing at the given
# endpoint (host:port). Empty or unset = no-op providers (SDK compiled
# in, zero overhead). Set OTEL_EXPORTER_OTLP_INSECURE=false for a TLS
# collector. OTEL_SERVICE_NAME overrides the per-cmd default (e.g.
# sjb-bot, sjb-subscription-svc). OTEL_METRICS_EXPORTER=none keeps traces
# but disables metrics.
# OTEL_EXPORTER_OTLP_ENDPOINT=otel-collector:4317
# OTEL_EXPORTER_OTLP_INSECURE=true
# OTEL_SERVICE_NAME=

# Calendar feed (ICS): users paste an iCal/ICS "secret address" from
# Google/Outlook/Apple via /menu → Profile → 📅 Calendar. cmd/bot polls
# the URL on CALENDAR_POLL_INTERVAL, expands RRULE within
# CALENDAR_LOOKAHEAD, and fans out "new", "changed", and "starts in N
# min" reminders (delivered by telegram-svc). Multi-replica bot
# deployments converge via DEDUP_REDIS_URL.
# CALENDAR_POLL_INTERVAL=5m
# CALENDAR_LOOKAHEAD=24h
# CALENDAR_FETCH_TIMEOUT=30s
# CALENDAR_DEFAULT_REMINDER_MIN=15
# CALENDAR_NEW_HORIZON — cap on which freshly-discovered events get a
# "🆕 New event" Telegram ping. Events beyond it are still tracked and
# trigger the regular "starts in N min" reminder when the time comes.
# CALENDAR_NEW_HORIZON=1h
